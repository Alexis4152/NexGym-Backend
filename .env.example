# Referencia de variables de entorno (ver tabla con el detalle de cada una en README.md).
#
# Spring Boot NO carga este archivo automaticamente -- no es un ".env" en el sentido de
# dotenv. Es solo para copiar/pegar: expórtalas en tu shell antes de "mvn spring-boot:run",
# o cárgalas como variables de entorno en el panel de tu proveedor de hosting/CI.
# NUNCA le pongas aqui un valor real y lo subas al repo -- este archivo solo lleva ejemplos.

# ---- Base de datos ----
DB_URL=jdbc:postgresql://localhost:5433/nexorasport
DB_USER=postgres
DB_PASSWORD=changeme

# ---- JWT ----
APP_JWT_SECRET=changeme-usa-una-cadena-larga-y-aleatoria-en-produccion
APP_JWT_ACCESS_MIN=30
APP_JWT_REFRESH_HOURS=8
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=Lax

# ---- CORS ----
APP_CORS_ORIGINS=http://localhost:5174

# ---- Archivos ----
APP_UPLOADS_DIR=uploads

# ---- Correo (SMTP) ----
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=

# ---- QZ Tray (impresion termica) ----
APP_QZ_CERT_PATH=qz-keys/digital-certificate.txt
APP_QZ_KEY_PATH=qz-keys/private-key.pem

# ---- Frontend ----
APP_FRONTEND_URL=http://localhost:5174

# ---- Semilla inicial ----
APP_SEED_ADMIN_EMAIL=admin@nexorasport.com
APP_SEED_ADMIN_PASSWORD=changeme

PORT=8081
